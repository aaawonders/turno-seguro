          ],
          "aoInteragir:diego": [
            { "tipo": "se", "flag": "diego-apresentou-sipat", "passos": [], "senao": [
              { "tipo": "fala", "personagem": "Diego", "expressao": "feliz", "texto": "E aí! Você é {nome}, que vai cobrir o Jonas? Sou o Diego, da CIPA." },
              { "tipo": "fala", "personagem": "Diego", "expressao": "neutra", "texto": "Caminho aqui dentro é só pela faixa de pedestre, tá? Empilhadeira não avisa." },
              { "tipo": "fala", "personagem": "Diego", "expressao": "feliz", "texto": "Ah, e essa semana tem SIPAT! A Semana Interna de Prevenção de Acidentes do Trabalho, que a CIPA organiza todo ano com o SESMT. O foco deste ano é saúde mental: estresse, pressão e pedir ajuda sem vergonha." },
              { "tipo": "fala", "personagem": "Diego", "expressao": "neutra", "texto": "A programação está no quadro ali. Dá uma olhada." },
              { "tipo": "flag", "nome": "diego-apresentou-sipat" },
