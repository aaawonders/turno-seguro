                { "tipo": "flag", "nome": "lembrete-calendario" }
              ] }
            ] }
          ],
          "aoSair": [
            { "tipo": "fala", "personagem": "Diego", "expressao": "neutra", "texto": "A Renata está te esperando lá na frente, no fim da faixa. Ela precisa de uma ajuda." },
            { "tipo": "irPara", "capitulo": 4, "area": "corredor-b" }
          ]
        },
        "corredor-b": {
          "aoEntrar": [ { "tipo": "objetivo", "ponto": "renata", "texto": "Fale com a Renata" } ],
          "aoInteragir:renata": [
            { "tipo": "se", "flag": "d4-feita", "passos": [], "senao": [
              { "tipo": "mostrarNpc", "nome": "renata" },
              { "tipo": "fala", "personagem": "Renata", "expressao": "preocupada", "texto": "Oi, {nome}! Chegou na hora. Me ajuda a terminar de isolar aqui? Ainda tem óleo no chão." },
              { "tipo": "objetivo", "texto": "Isole a área do vazamento com os cones" },
              { "tipo": "acao", "acao": "cones" },
              { "tipo": "fala", "personagem": "Renata", "expressao": "neutra", "texto": "Obrigada." },
              { "tipo": "flag", "nome": "d4-feita" },
              { "tipo": "fala", "personagem": "Renata", "expressao": "preocupada", "texto": "Foi aqui. Vazou óleo daquela máquina do posto do Jonas. Ele escorregou, caiu e cortou o braço na quina de um carrinho." },
              { "tipo": "fala", "personagem": "Renata", "expressao": "seria", "texto": "O Caio chegou primeiro. Correu pelo óleo, quase caiu junto, levantou o Jonas pelo braço e enrolou o corte com a estopa suja da máquina." },
              { "tipo": "fala", "personagem": "Renata", "expressao": "seria", "texto": "Ia levar ele andando até o ambulatório, sem chamar ninguém." },
              { "tipo": "mostrarNpc", "nome": "caio" },
              { "tipo": "flag", "nome": "caio-apareceu" },
              { "tipo": "liberar", "ponto": "caio" },
              { "tipo": "moverNpc", "nome": "caio", "ponto": "caio" },
              { "tipo": "objetivo", "ponto": "caio", "texto": "Oriente o Caio" },
              { "tipo": "fala", "personagem": "Caio", "expressao": "envergonhado", "texto": "Eu só queria ajudar… Travei e fiz o que veio na cabeça." },
              { "tipo": "fala", "personagem": "Renata", "expressao": "neutra", "texto": "Ninguém está te culpando, Caio. {nome}, você acabou de passar pela integração, está com tudo fresco. Explica pra ele como deveria ter sido?" }
            ] }
          ],
          "aoInteragir:caio": [
            { "tipo": "se", "flag": "d5-a-d9-feitas", "passos": [], "senao": [
              { "tipo": "fala", "personagem": "Caio", "expressao": "neutra", "texto": "Quando eu vi o Jonas no chão, o que eu devia ter feito primeiro?" },
              { "tipo": "decisao", "id": "D5" },
              { "tipo": "reacaoDecisao", "id": "D5", "personagem": "Caio" },
              { "tipo": "fala", "personagem": "Caio", "expressao": "neutra", "texto": "E pra chamar a brigada? Eu nem sei como." },
              { "tipo": "decisao", "id": "D6" },
              { "tipo": "fala", "personagem": "Caio", "expressao": "neutra", "texto": "Anotado." },
              { "tipo": "fala", "personagem": "Caio", "expressao": "preocupada", "texto": "E o sangue? Eu peguei o que tinha na mão." },
              { "tipo": "decisao", "id": "D7" },
              { "tipo": "fala", "personagem": "Caio", "expressao": "neutra", "texto": "Entendi." },
              { "tipo": "fala", "personagem": "Caio", "expressao": "neutra", "texto": "E levar ele andando até o ambulatório, foi errado?" },
              { "tipo": "decisao", "id": "D8" },
              { "tipo": "reacaoDecisao", "id": "D8", "personagem": "Caio" },
              { "tipo": "fala", "personagem": "Caio", "expressao": "envergonhado", "texto": "Posso falar uma coisa? Eu não dormi essa noite. Fico vendo a cena e achando que piorei tudo." },
              { "tipo": "decisao", "id": "D9" },
              { "tipo": "reacaoDecisao", "id": "D9", "personagem": "Caio" },
              { "tipo": "moverNpc", "nome": "caio", "ponto": "saida", "modo": "sair" },
              { "tipo": "esconderNpc", "nome": "caio" },
              { "tipo": "flag", "nome": "d5-a-d9-feitas" },
              { "tipo": "liberar", "ponto": "prancheta" },
              { "tipo": "fala", "personagem": "Renata", "expressao": "preocupada", "texto": "Sabe que eu também fiquei mexida? Socorri o Jonas com a mão firme, mas cheguei em casa e desabei." },
              { "tipo": "fala", "personagem": "Renata", "expressao": "neutra", "texto": "Quem socorre também sente. Hoje cedo conversei com o pessoal do ambulatório e já estou melhor." },
              { "tipo": "fala", "personagem": "Renata", "expressao": "feliz", "texto": "Este ano a SIPAT vai falar muito disso: saúde mental. Cuidar da cabeça também é segurança." },
              { "tipo": "fala", "personagem": "Renata", "expressao": "neutra", "texto": "Agora preciso registrar o acidente oficialmente. Me passa o formulário certo ali da prancheta?" },
              { "tipo": "objetivo", "ponto": "prancheta", "texto": "Pegue o formulário certo na prancheta" }
            ] }
          ],
          "aoInteragir:prancheta": [
            { "tipo": "se", "flag": "d10-d11-feitas", "passos": [], "senao": [
              { "tipo": "decisao", "id": "D10" },
              { "tipo": "fala", "personagem": "Renata", "expressao": "neutra", "texto": "Obrigada." },
              { "tipo": "fala", "personagem": "Renata", "expressao": "seria", "texto": "O pior é que esse vazamento já tinha sido visto dois dias antes. Todo mundo achou que alguém já tinha avisado." },
              { "tipo": "fala", "personagem": "Renata", "expressao": "neutra", "texto": "Se fosse você que visse aquele vazamento, o que faria?" },
              { "tipo": "decisao", "id": "D11" },
              { "tipo": "fala", "personagem": "Renata", "expressao": "neutra", "texto": "Hum. Guarda isso, que a gente vai precisar já já." },
              { "tipo": "flag", "nome": "d10-d11-feitas" },
              { "tipo": "fala", "personagem": "Renata", "expressao": "neutra", "texto": "Vamos pro posto. Antes de ligar qualquer coisa, a gente faz a inspeção de início de turno." },
              { "tipo": "liberar", "ponto": "saida" },
              { "tipo": "objetivo", "ponto": "saida", "texto": "Vá até o posto do Jonas" }
            ] }
          ],
          "aoTentarSair": [
            { "tipo": "se", "flag": "d10-d11-feitas", "passos": [], "senao": [] }
          ],
          "aoSair": [
            { "tipo": "fala", "personagem": "{nome}", "expressao": "neutra", "pensando": true, "texto": "Inspeção de início de turno… olho vivo." },
            { "tipo": "irPara", "capitulo": 5, "area": "posto" }
          ]
        }
      }
