    "6": {
      "area": "posto",
      "mapas": {
        "posto": {
          "aoEntrar": [
            { "tipo": "mostrarNpc", "nome": "diego" },
            { "tipo": "moverNpc", "nome": "diego", "ponto": "diego" },
            { "tipo": "fala", "personagem": "Diego", "expressao": "feliz", "texto": "E aí, {nome}! Sou o Diego, da CIPA. A Renata disse que você fez a inspeção. Me conta o que achou." },
            { "tipo": "acao", "acao": "relatoTablet" },
            { "tipo": "fala", "personagem": "Diego", "expressao": "neutra", "texto": "Valeu pelo relato. É assim que se evita o próximo acidente: alguém vê, alguém avisa." },
            { "tipo": "fala", "personagem": "Diego", "expressao": "feliz", "texto": "E é exatamente isso que a SIPAT discute. É a Semana Interna de Prevenção de Acidentes do Trabalho, que a CIPA organiza todo ano com o SESMT. E este ano o foco principal é saúde mental: estresse, pressão e pedir ajuda sem vergonha." },
            { "tipo": "fala", "personagem": "Diego", "expressao": "neutra", "texto": "Este ano vai de 16 a 19 de novembro." },
            { "tipo": "fala", "personagem": "Diego", "expressao": "neutra", "texto": "Lembra do quadro lá na entrada? Te espero nas atividades!" },
            { "tipo": "fala", "personagem": "Diego", "expressao": "feliz", "texto": "Te espero lá! E qualquer condição insegura, fala com qualquer cipeiro." },
